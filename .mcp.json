{
  "mcpServers": {
    "claude-flow": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "flat",
        "CLAUDE_FLOW_MAX_AGENTS": "4",
        "CLAUDE_FLOW_MEMORY_BACKEND": "sqlite",
        "CLAUDE_FLOW_TOKEN_SAVER": "true",
        "CLAUDE_FLOW_LAZY_LOAD": "true",
        "CLAUDE_FLOW_CONCURRENCY": "2"
      },
      "autoStart": true
    }
  }
}
