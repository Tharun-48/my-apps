# Ignore local workspace scripts
scripts/

# Build artifacts & executables
target/
**/target/
build/
**/build/
.gradle/
**/.gradle/
*.exe
*.tmp
*.log
.idea/
**/.idea/

# Ensure release APKs are explicitly tracked
!pro-stats/releases/*.apk

# RuFlo runtime & daemon files (keep config and policy)
.claude-flow/agents/
.claude-flow/daemon.pid
.claude-flow/daemon-state.json
.claude-flow/metrics/
.swarm/state.json
.swarm/memory.db

# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
